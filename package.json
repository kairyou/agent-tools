{
  "name": "@kairyou/agent-tools",
  "version": "0.23.0",
  "description": "Reusable Agent Skills plus per-agent runtime capabilities for compatible coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kairyou/agent-tools.git"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "config.default.jsonc",
    ".claude-plugin/",
    ".codex-plugin/",
    ".zcode-plugin/",
    "docs/",
    "dist/",
    "capabilities/",
    "scripts/",
    "skills/"
  ],
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "esbuild": "0.28.2",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "version": "node scripts/sync-plugin-version.mjs",
    "claude-skills:fetch": "node tools/claude-skill-sync/cli.mjs fetch",
    "claude-skills:inspect": "node tools/claude-skill-sync/cli.mjs inspect",
    "claude-skills:apply": "node tools/claude-skill-sync/cli.mjs apply",
    "claude-skills:check": "node tools/claude-skill-sync/cli.mjs check",
    "release": "node scripts/release.mjs --target=registry",
    "release:github": "node scripts/release.mjs --target=github"
  },
  "bin": {
    "agent-tools": "./scripts/install.mjs"
  }
}
